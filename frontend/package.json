    "test:dashboard-typing-ui": "node tests/dashboardTyping.browser.mjs",
    "test:scene-script-ui": "node tests/sceneScript.browser.mjs",
    "test:session-journal": "node --test tests/sessionJournal.test.mjs",
    "test:session-journal-ui": "node tests/sessionJournal.browser.mjs",
    "test:search": "node --test tests/worldSearch.test.mjs",
    "test:search-ui": "node tests/search.browser.mjs",
    "test:map-editing": "node --test tests/mapEditing.test.mjs tests/markerStyles.test.mjs tests/mapConflicts.test.mjs",
